# Outlook email → project action items (STEP261/262) — Edge Function secrets.
# PLACEHOLDERS ONLY. Copy to a file outside git (e.g. supabase/.env.outlook), fill in, then:
#   npx supabase secrets set --env-file supabase/.env.outlook --project-ref <project-ref>
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# Shared with send-email: the cron job sends "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=<long-random-string>

# Microsoft Entra ID app registration (optional defaults). Each mailbox can carry
# its own tenant / client id in Settings → Outlook Email, and its own client
# secret (stored write-only in the database). These are used when it doesn't.
MS_GRAPH_TENANT_ID=<directory-tenant-id-guid>
MS_GRAPH_CLIENT_ID=<application-client-id-guid>
MS_GRAPH_CLIENT_SECRET=<client-secret-value>

# Optional: override the webhook URL Graph calls (default: <SUPABASE_URL>/functions/v1/outlook-webhook)
# OUTLOOK_WEBHOOK_URL=https://<project-ref>.supabase.co/functions/v1/outlook-webhook

# Optional AI fallbacks when the organization has no key in Settings → AI / LLM Keys.
# Leave all blank to classify with the built-in keyword rules only.
# ANTHROPIC_API_KEY=<sk-ant-...>
# DEEPSEEK_API_KEY=<sk-...>
# GEMINI_API_KEY=<...>
